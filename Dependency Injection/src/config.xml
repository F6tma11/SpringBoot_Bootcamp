<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context.xsd">

    <bean id="draw2D" class="classes.Draw2D"></bean>
    <bean id="draw3D" class="classes.Draw3D"></bean>

    <bean id="circle" class="classes.Circle">
        <constructor-arg type="classes.Draw2D" ref="draw2D"/>
        <constructor-arg type="classes.Draw3D" ref="draw3D"/>
    </bean>

    <bean id="rectangle" class="classes.Rectangle">
        <property name="draw2D" ref="draw2D"/>
        <property name="draw3D" ref="draw3D"/>
    </bean>

    <bean id="triangle" class="classes.Triangle">
        <constructor-arg type="classes.Draw2D" ref="draw2D"/>
        <property name="draw3D" ref="draw3D"/>
    </bean>

</beans>